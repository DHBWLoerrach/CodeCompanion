#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

started_at=$SECONDS

echo "[setup] Configuring repository-local Git identity"
git config --local user.name "Erik Behrends"
git config --local user.email "behrends@users.noreply.github.com"

echo "[setup] Checking Node.js and npm"
command -v node >/dev/null || {
  echo "[setup] Node.js is required (version 20 or newer)" >&2
  exit 1
}
command -v npm >/dev/null || {
  echo "[setup] npm is required (version 10 or newer)" >&2
  exit 1
}

node_major="$(node -p 'process.versions.node.split(`.`)[0]')"
npm_major="$(npm --version | cut -d. -f1)"
if ((node_major < 20)); then
  echo "[setup] Node.js 20 or newer is required; found $(node --version)" >&2
  exit 1
fi
if ((npm_major < 10)); then
  echo "[setup] npm 10 or newer is required; found $(npm --version)" >&2
  exit 1
fi
echo "[setup] Using Node.js $(node --version) and npm $(npm --version)"

if [[ ! -f .env.local ]]; then
  echo "[setup] Creating .env.local from .env.example"
  cp -- .env.example .env.local
else
  echo "[setup] Keeping existing .env.local"
fi

echo "[setup] Installing dependencies from package-lock.json"
npm ci --no-audit --no-fund

echo "[setup] Complete in $((SECONDS - started_at))s"
