{
  "name": "code-companion",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "generate:topic-explanations": "node --experimental-strip-types scripts/generate-topic-explanations.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --runInBand --coverage=false __tests__/unit",
    "test:integration": "jest --runInBand --coverage=false __tests__/integration --passWithNoTests",
    "test:e2e": "maestro test e2e/maestro --include-tags smoke",
    "test:e2e:ai": "maestro test e2e/maestro --include-tags ai",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-vector-icons/feather": "^13.1.2",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.90.7",
    "expo": "~58.0.21",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ease": "^0.9.0",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.8.1",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false
  },
  "private": true
}
